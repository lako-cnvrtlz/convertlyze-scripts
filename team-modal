<!-- ═══════════════════════════════════════════════════════════
     CONVERTLYZE · TEAM MANAGEMENT MODAL
     Als Custom Code Embed in Webflow einfügen.
     Trigger-Button braucht: id="open-team-modal"
     ═══════════════════════════════════════════════════════════ -->

<style>
  /* ── Variablen ── */
  :root {
    --cvl-bg:        #0d1117;
    --cvl-surface:   #161b27;
    --cvl-border:    #252d3d;
    --cvl-border2:   #1e2738;
    --cvl-text:      #e8edf5;
    --cvl-muted:     #6b7a99;
    --cvl-accent:    #4fd1c5;
    --cvl-accent2:   #38b2ac;
    --cvl-danger:    #fc8181;
    --cvl-danger-bg: rgba(252,129,129,0.08);
    --cvl-success:   #68d391;
    --cvl-tag-bg:    rgba(79,209,197,0.1);
    --cvl-radius:    0px;
    --cvl-radius-sm: 0px;
  }

  #cvl-team-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(5,8,15,0.75);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  #cvl-team-overlay.is-open {
    display: flex;
    animation: cvl-fade-in 0.2s ease;
  }
  @keyframes cvl-fade-in { from { opacity: 0; } to { opacity: 1; } }

  #cvl-team-modal {
    background: var(--cvl-surface);
    border: 1px solid var(--cvl-border);
    border-radius: var(--cvl-radius);
    width: 100%;
    max-width: 600px;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,0.6);
    animation: cvl-slide-up 0.25s cubic-bezier(0.16,1,0.3,1);
  }
  @keyframes cvl-slide-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .cvl-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px 0;
    flex-shrink: 0;
  }
  .cvl-modal-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--cvl-text);
    letter-spacing: -0.01em;
    margin: 0;
  }
  .cvl-modal-close {
    width: 32px; height: 32px;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: var(--cvl-muted);
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s, color 0.15s;
    flex-shrink: 0;
  }
  .cvl-modal-close:hover { background: var(--cvl-border); color: var(--cvl-text); }

  .cvl-seat-bar {
    margin: 14px 24px 0;
    background: var(--cvl-bg);
    border: 1px solid var(--cvl-border);
    border-radius: var(--cvl-radius-sm);
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .cvl-seat-label { font-size: 13px; color: var(--cvl-muted); }
  .cvl-seat-count { font-size: 13px; font-weight: 600; color: var(--cvl-accent); }
  .cvl-seat-progress {
    flex: 1;
    height: 4px;
    background: var(--cvl-border);
    border-radius: 99px;
    overflow: hidden;
    max-width: 120px;
  }
  .cvl-seat-progress-bar {
    height: 100%;
    background: var(--cvl-accent);
    border-radius: 99px;
    transition: width 0.4s ease;
  }

  .cvl-tabs {
    display: flex;
    gap: 4px;
    padding: 16px 24px 0;
    flex-shrink: 0;
  }
  .cvl-tab {
    padding: 7px 14px;
    border-radius: var(--cvl-radius-sm);
    border: none;
    background: transparent;
    color: var(--cvl-muted);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
  }
  .cvl-tab:hover { color: var(--cvl-text); background: var(--cvl-border2); }
  .cvl-tab.is-active { background: var(--cvl-tag-bg); color: var(--cvl-accent); }
  .cvl-tab-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px; height: 18px;
    background: var(--cvl-accent);
    color: var(--cvl-bg);
    border-radius: 99px;
    font-size: 10px;
    font-weight: 700;
    margin-left: 6px;
    vertical-align: middle;
  }

  .cvl-divider { height: 1px; background: var(--cvl-border); margin: 14px 24px 0; flex-shrink: 0; }

  .cvl-modal-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px 24px;
    scrollbar-width: thin;
    scrollbar-color: var(--cvl-border) transparent;
  }
  .cvl-modal-body::-webkit-scrollbar { width: 4px; }
  .cvl-modal-body::-webkit-scrollbar-thumb { background: var(--cvl-border); border-radius: 99px; }

  .cvl-panel { display: none; }
  .cvl-panel.is-active { display: block; }

  .cvl-member-list { display: flex; flex-direction: column; gap: 8px; }
  .cvl-member-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: var(--cvl-bg);
    border: 1px solid var(--cvl-border);
    border-radius: var(--cvl-radius-sm);
    transition: border-color 0.15s;
  }
  .cvl-member-row:hover { border-color: var(--cvl-border2); }
  .cvl-avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--cvl-tag-bg);
    border: 1px solid var(--cvl-accent);
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 600;
    color: var(--cvl-accent);
    flex-shrink: 0;
  }
  .cvl-member-info { flex: 1; min-width: 0; }
  .cvl-member-name {
    font-size: 14px; font-weight: 500; color: var(--cvl-text);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .cvl-member-email {
    font-size: 12px; color: var(--cvl-muted);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .cvl-member-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

  .cvl-tag {
    padding: 3px 9px;
    border-radius: 99px;
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .cvl-tag-owner  { background: rgba(246,173,85,0.12); color: #f6ad55; }
  .cvl-tag-member { background: var(--cvl-border2); color: var(--cvl-muted); }

  .cvl-btn-icon {
    width: 30px; height: 30px;
    border-radius: 7px;
    border: 1px solid var(--cvl-border);
    background: transparent;
    color: var(--cvl-muted);
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.15s;
  }
  .cvl-btn-icon:hover { background: var(--cvl-danger-bg); border-color: var(--cvl-danger); color: var(--cvl-danger); }

  .cvl-btn-primary {
    padding: 9px 18px;
    border-radius: var(--cvl-radius-sm);
    border: none;
    background: var(--cvl-accent);
    color: var(--cvl-bg);
    font-size: 14px; font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s;
    display: inline-flex; align-items: center; gap: 7px;
  }
  .cvl-btn-primary:hover { background: var(--cvl-accent2); }
  .cvl-btn-primary:active { transform: scale(0.98); }
  .cvl-btn-primary:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
  .cvl-btn-primary.is-loading { pointer-events: none; opacity: 0.7; }

  .cvl-btn-ghost {
    padding: 7px 14px;
    border-radius: var(--cvl-radius-sm);
    border: 1px solid var(--cvl-border);
    background: transparent;
    color: var(--cvl-muted);
    font-size: 13px; font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .cvl-btn-ghost:hover { border-color: var(--cvl-danger); color: var(--cvl-danger); background: var(--cvl-danger-bg); }

  .cvl-btn-leave {
    padding: 7px 14px;
    border-radius: var(--cvl-radius-sm);
    border: 1px solid var(--cvl-danger);
    background: transparent;
    color: var(--cvl-danger);
    font-size: 13px; font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .cvl-btn-leave:hover { background: var(--cvl-danger-bg); }
  .cvl-btn-leave:disabled { opacity: 0.5; cursor: not-allowed; }

  .cvl-form-group { margin-bottom: 16px; }
  .cvl-label { display: block; font-size: 13px; font-weight: 500; color: var(--cvl-muted); margin-bottom: 7px; }
  .cvl-input {
    width: 100%; padding: 10px 14px;
    background: var(--cvl-bg);
    border: 1px solid var(--cvl-border);
    border-radius: var(--cvl-radius-sm);
    color: var(--cvl-text); font-size: 14px;
    outline: none; transition: border-color 0.15s; box-sizing: border-box;
  }
  .cvl-input::placeholder { color: var(--cvl-muted); opacity: 0.6; }
  .cvl-input:focus { border-color: var(--cvl-accent); }
  .cvl-form-footer { display: flex; justify-content: flex-end; margin-top: 20px; }

  .cvl-invite-row {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px;
    background: var(--cvl-bg);
    border: 1px solid var(--cvl-border);
    border-radius: var(--cvl-radius-sm);
    margin-bottom: 8px; flex-wrap: wrap;
  }
  .cvl-invite-icon {
    width: 36px; height: 36px; border-radius: 50%;
    background: rgba(246,173,85,0.1);
    border: 1px solid rgba(246,173,85,0.3);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .cvl-invite-info { flex: 1; min-width: 120px; }
  .cvl-invite-email { font-size: 14px; color: var(--cvl-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cvl-invite-meta { font-size: 12px; color: var(--cvl-muted); margin-top: 2px; }
  .cvl-invite-actions { display: flex; gap: 8px; flex-wrap: wrap; flex-shrink: 0; }
  @media (max-width: 480px) {
    .cvl-invite-actions { width: 100%; justify-content: flex-end; }
    .cvl-btn-ghost { font-size: 12px; padding: 6px 10px; }
  }

  #cvl-toast {
    position: fixed; bottom: 24px; right: 24px;
    padding: 12px 18px;
    border-radius: var(--cvl-radius-sm);
    font-size: 14px; font-weight: 500; color: var(--cvl-bg);
    z-index: 10000; display: none;
    animation: cvl-toast-in 0.25s cubic-bezier(0.16,1,0.3,1);
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  }
  #cvl-toast.is-success { background: var(--cvl-success); display: block; }
  #cvl-toast.is-error   { background: var(--cvl-danger);  display: block; }
  @keyframes cvl-toast-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .cvl-empty { text-align: center; padding: 32px 20px; color: var(--cvl-muted); font-size: 14px; }
  .cvl-empty-icon { font-size: 28px; margin-bottom: 10px; }

  .cvl-spinner {
    width: 20px; height: 20px;
    border: 2px solid var(--cvl-border);
    border-top-color: var(--cvl-accent);
    border-radius: 50%;
    animation: cvl-spin 0.7s linear infinite;
    margin: 32px auto;
  }
  @keyframes cvl-spin { to { transform: rotate(360deg); } }
</style>

<!-- Overlay -->
<div id="cvl-team-overlay" role="dialog" aria-modal="true" aria-label="Team verwalten">

  <!-- Bestätigungs-Modal -->
  <div id="cvl-confirm-modal" style="display:none;position:absolute;inset:0;background:rgba(0,0,0,0.6);z-index:100;border-radius:20px;align-items:center;justify-content:center;">
    <div style="background:#1a2035;border:1px solid var(--cvl-border);border-radius:16px;padding:28px;max-width:340px;width:90%;box-shadow:0 16px 48px rgba(0,0,0,0.5);">
      <div style="width:44px;height:44px;border-radius:12px;background:rgba(239,68,68,0.12);display:flex;align-items:center;justify-content:center;margin-bottom:16px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <line x1="17" y1="8" x2="23" y2="8"/></svg>
      </div>
      <p style="font-size:16px;font-weight:700;color:var(--cvl-text);margin:0 0 8px" id="cvl-confirm-title">Mitglied entfernen?</p>
      <p style="font-size:13px;color:var(--cvl-muted);margin:0 0 20px;line-height:1.6" id="cvl-confirm-text">Das Mitglied verliert den Zugang zum Team.</p>
      <div style="display:flex;gap:10px;">
        <button id="cvl-confirm-cancel" style="flex:1;padding:10px;border-radius:10px;border:1px solid var(--cvl-border);background:transparent;color:var(--cvl-muted);font-size:14px;font-weight:500;cursor:pointer;">Abbrechen</button>
        <button id="cvl-confirm-ok" style="flex:1;padding:10px;border-radius:10px;border:none;background:#ef4444;color:#fff;font-size:14px;font-weight:600;cursor:pointer;">Bestätigen</button>
      </div>
    </div>
  </div>

  <div id="cvl-team-modal">

    <!-- Header -->
    <div class="cvl-modal-header">
      <p class="cvl-modal-title">Team verwalten</p>
      <button class="cvl-modal-close" id="cvl-close-btn" aria-label="Schließen">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <!-- Seat-Anzeige -->
    <div class="cvl-seat-bar">
      <span class="cvl-seat-label">Seats genutzt</span>
      <div class="cvl-seat-progress">
        <div class="cvl-seat-progress-bar" id="cvl-seat-bar" style="width: 0%"></div>
      </div>
      <span class="cvl-seat-count" id="cvl-seat-count">0 / 0</span>
    </div>

    <!-- Tabs -->
    <div class="cvl-tabs" role="tablist">
      <button class="cvl-tab is-active" data-tab="members" role="tab">Mitglieder</button>
      <button class="cvl-tab" data-tab="invite" role="tab">Einladen</button>
      <button class="cvl-tab" data-tab="pending" role="tab">
        Offen <span class="cvl-tab-badge" id="cvl-pending-badge" style="display:none">0</span>
      </button>
    </div>

    <div class="cvl-divider"></div>

    <!-- Body -->
    <div class="cvl-modal-body">

      <!-- Panel: Mitglieder -->
      <div class="cvl-panel is-active" id="cvl-panel-members">
        <div class="cvl-spinner" id="cvl-members-spinner"></div>
        <div class="cvl-member-list" id="cvl-member-list" style="display:none"></div>
      </div>

      <!-- Panel: Einladen -->
      <div class="cvl-panel" id="cvl-panel-invite">
        <div class="cvl-form-group">
          <label class="cvl-label" for="cvl-invite-email">E-Mail-Adresse</label>
          <input class="cvl-input" id="cvl-invite-email" type="email" placeholder="member@leadmachine.de" autocomplete="off"/>
        </div>
        <div class="cvl-form-footer">
          <button class="cvl-btn-primary" id="cvl-invite-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
              <path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Einladung senden
          </button>
        </div>
      </div>

      <!-- Panel: Offene Einladungen -->
      <div class="cvl-panel" id="cvl-panel-pending">
        <div class="cvl-spinner" id="cvl-pending-spinner"></div>
        <div id="cvl-pending-list" style="display:none"></div>
      </div>

    </div>
  </div>
</div>

<div id="cvl-toast"></div>

<script>
(function () {

  var SUPABASE_URL      = window.cvlSupabaseUrl     || '';
  var SUPABASE_ANON_KEY = window.cvlSupabaseAnonKey || '';
  var EDGE_BASE         = SUPABASE_URL + '/functions/v1';

  if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
    console.error('[CVZ] Team Modal: cvlSupabaseUrl oder cvlSupabaseAnonKey nicht gesetzt.');
  }

  var currentUserId        = null;
  var currentTeamId        = null;
  var currentMemberstackId = null;
  var currentUserIsOwner   = false;

  // ── Utilities ──────────────────────────────────────────────────────────────

  function qs(sel) { return document.querySelector(sel); }

  function getInitials(name) {
    if (!name) return '?';
    var p = name.trim().split(/\s+/);
    if (p.length === 1) return p[0][0].toUpperCase();
    return (p[0][0] + p[p.length - 1][0]).toUpperCase();
  }

  function formatDate(iso) {
    if (!iso) return '';
    return new Date(iso).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
  }

  // ── UI helpers ─────────────────────────────────────────────────────────────

  function showConfirm(title, text, onConfirm) {
    var modal   = document.getElementById('cvl-confirm-modal');
    var okBtn   = document.getElementById('cvl-confirm-ok');
    var cancel  = document.getElementById('cvl-confirm-cancel');
    var titleEl = document.getElementById('cvl-confirm-title');
    var textEl  = document.getElementById('cvl-confirm-text');
    if (!modal) { onConfirm(); return; }
    titleEl.textContent = title;
    textEl.textContent  = text;
    modal.style.display = 'flex';
    function close() { modal.style.display = 'none'; }
    okBtn.onclick  = function () { close(); onConfirm(); };
    cancel.onclick = close;
  }

  function showToast(msg, type) {
    var t = qs('#cvl-toast');
    t.textContent = msg;
    t.className   = type === 'error' ? 'is-error' : 'is-success';
    clearTimeout(t._timer);
    t._timer = setTimeout(function () { t.className = ''; }, 4000);
  }

  function updateSeatBar(used, max) {
    var pct = max > 0 ? Math.min((used / max) * 100, 100) : 0;
    qs('#cvl-seat-bar').style.width   = pct + '%';
    qs('#cvl-seat-count').textContent = used + ' / ' + max;
  }

  function resetInviteBtn(btn) {
    btn.classList.remove('is-loading');
    btn.disabled    = false;
    btn.textContent = '';
    var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('width', '15'); svg.setAttribute('height', '15');
    svg.setAttribute('viewBox', '0 0 24 24'); svg.setAttribute('fill', 'none');
    var path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('d', 'M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z');
    path.setAttribute('stroke', 'currentColor'); path.setAttribute('stroke-width', '2');
    path.setAttribute('stroke-linecap', 'round'); path.setAttribute('stroke-linejoin', 'round');
    svg.appendChild(path);
    btn.appendChild(svg);
    btn.appendChild(document.createTextNode(' Einladung senden'));
  }

  // ── API layer ──────────────────────────────────────────────────────────────

  async function edgeFetch(endpoint, body) {
    var res = await fetch(EDGE_BASE + endpoint, {
      method:  'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + SUPABASE_ANON_KEY },
      body:    JSON.stringify(body),
    });
    return res.json();
  }

  async function supabaseGet(path) {
    var res = await fetch(SUPABASE_URL + '/rest/v1' + path, {
      headers: {
        'apikey':        SUPABASE_ANON_KEY,
        'Authorization': 'Bearer ' + SUPABASE_ANON_KEY,
        'Content-Type':  'application/json',
      },
    });
    return res.json();
  }

  // ── Member row builder (XSS-safe) ──────────────────────────────────────────

  function buildMemberRow(m) {
    var user    = m.users || {};
    var isOwner = (m.role === 'admin' && user.id === currentUserId);
    var isMe    = (user.memberstack_id === currentMemberstackId);

    var row = document.createElement('div');
    row.className = 'cvl-member-row';

    // Avatar
    var avatar = document.createElement('div');
    avatar.className   = 'cvl-avatar';
    avatar.textContent = getInitials(user.full_name || user.email);
    row.appendChild(avatar);

    // Info
    var info     = document.createElement('div');
    info.className = 'cvl-member-info';
    var nameEl   = document.createElement('div');
    nameEl.className   = 'cvl-member-name';
    nameEl.textContent = user.full_name || '\u2013';
    if (isMe) {
      var meBadge = document.createElement('span');
      meBadge.textContent = ' (Du)';
      meBadge.style.cssText = 'color:var(--cvl-muted);font-size:11px';
      nameEl.appendChild(meBadge);
    }
    var emailEl = document.createElement('div');
    emailEl.className   = 'cvl-member-email';
    emailEl.textContent = user.email || '';
    info.append(nameEl, emailEl);
    row.appendChild(info);

    // Actions
    var actions = document.createElement('div');
    actions.className = 'cvl-member-actions';

    var tag = document.createElement('span');
    tag.className   = 'cvl-tag ' + (isOwner ? 'cvl-tag-owner' : 'cvl-tag-member');
    tag.textContent = isOwner ? 'Owner' : 'Member';
    actions.appendChild(tag);

    // Remove-Button nur für Owner sichtbar, nicht für sich selbst und nicht für andere Owner
    if (!isOwner && !isMe && currentUserIsOwner) {
      var removeBtn = document.createElement('button');
      removeBtn.className = 'cvl-btn-icon';
      removeBtn.title     = 'Entfernen';
      removeBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      var userId = m.user_id;
      removeBtn.addEventListener('click', function () {
        showConfirm(
          'Mitglied entfernen?',
          'Mitglied wirklich aus dem Team entfernen? Der Zugang geht sofort verloren.',
          async function () {
            removeBtn.disabled = true;
            try {
              var res = await edgeFetch('/remove-team-member', {
                requester_memberstack_id: currentMemberstackId,
                target_user_id:          userId,
              });
              if (res.success) {
                showToast('Mitglied wurde entfernt.', 'success');
                loadMembers();
              } else {
                showToast(res.error || 'Fehler beim Entfernen.', 'error');
                removeBtn.disabled = false;
              }
            } catch (e) {
              showToast('Verbindungsfehler.', 'error');
              removeBtn.disabled = false;
            }
          }
        );
      });
      actions.appendChild(removeBtn);
    }

    // Leave-Button nur für eingeloggten Member sichtbar (nicht für Owner)
    if (isMe && !isOwner) {
      var leaveBtn = document.createElement('button');
      leaveBtn.className   = 'cvl-btn-leave';
      leaveBtn.textContent = 'Team verlassen';
      leaveBtn.addEventListener('click', function () {
        showConfirm(
          'Team verlassen?',
          'Du wirst auf den kostenlosen Free-Plan zur\u00fcckgesetzt. Deine bisherigen Analysen bleiben erhalten.',
          async function () {
            leaveBtn.disabled = true;
            try {
              var res = await edgeFetch('/leave-team', { memberstack_id: currentMemberstackId });
              if (res.success) {
                showToast('Du hast das Team verlassen.', 'success');
                closeModal();
                setTimeout(function () { window.location.reload(); }, 1200);
              } else {
                showToast(res.error || 'Fehler beim Verlassen.', 'error');
                leaveBtn.disabled = false;
              }
            } catch (e) {
              showToast('Verbindungsfehler.', 'error');
              leaveBtn.disabled = false;
            }
          }
        );
      });
      actions.appendChild(leaveBtn);
    }

    row.appendChild(actions);
    return row;
  }

  // ── Member laden ───────────────────────────────────────────────────────────

  async function loadMembers() {
    var spinner = qs('#cvl-members-spinner');
    var list    = qs('#cvl-member-list');

    spinner.style.display = 'block';
    list.style.display    = 'none';
    list.innerHTML        = '';

    try {
      var result      = await edgeFetch('/get-team-members', { memberstack_id: currentMemberstackId });
      var data        = result.members    || [];
      var planMax     = result.max_seats  != null ? result.max_seats  : 0;
      var memberCount = result.used_seats != null ? result.used_seats : 0;

      if (result.owner_id) currentUserId = result.owner_id;
      if (result.team_id)  currentTeamId = result.team_id;

      updateSeatBar(memberCount, planMax);
      spinner.style.display = 'none';
      list.style.display    = 'flex';

      if (!data.length) {
        var empty = document.createElement('div');
        empty.className = 'cvl-empty';
        var icon = document.createElement('div');
        icon.className   = 'cvl-empty-icon';
        icon.textContent = '\uD83D\uDC65';
        var msg = document.createTextNode('Noch keine Team-Mitglieder. Lade jemanden ein!');
        empty.append(icon, msg);
        list.appendChild(empty);
        return;
      }

      data.forEach(function (m) { list.appendChild(buildMemberRow(m)); });

    } catch (e) {
      console.error('[CVZ] loadMembers error:', e);
      spinner.style.display = 'none';
      list.style.display    = 'flex';
      list.innerHTML = '<div class="cvl-empty" style="color:var(--cvl-danger)">Fehler beim Laden. Bitte erneut versuchen.</div>';
    }
  }

  // ── Pending Invites laden ──────────────────────────────────────────────────

  async function loadPending() {
    var spinner = qs('#cvl-pending-spinner');
    var list    = qs('#cvl-pending-list');

    spinner.style.display = 'block';
    list.style.display    = 'none';
    list.innerHTML        = '';

    try {
      var data = [];
      if (currentTeamId) {
        var now = new Date().toISOString();
        data = await supabaseGet(
          '/team_invites?team_id=eq.' + currentTeamId +
          '&accepted_at=is.null&expires_at=gt.' + now +
          '&select=id,email,created_at,expires_at'
        );
      }

      spinner.style.display = 'none';
      list.style.display    = 'block';

      var badge = qs('#cvl-pending-badge');
      if (data && data.length > 0) {
        badge.textContent   = data.length;
        badge.style.display = 'inline-flex';
      } else {
        badge.style.display = 'none';
      }

      if (!data || !data.length) {
        list.innerHTML = '<div class="cvl-empty"><div class="cvl-empty-icon">\u2709\uFE0F</div>Keine offenen Einladungen.</div>';
        return;
      }

      data.forEach(function (inv) {
        var row = document.createElement('div');
        row.className = 'cvl-invite-row';
        row.innerHTML =
          '<div class="cvl-invite-icon">' +
            '<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke="#f6ad55" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
          '</div>' +
          '<div class="cvl-invite-info">' +
            '<div class="cvl-invite-email"></div>' +
            '<div class="cvl-invite-meta"></div>' +
          '</div>' +
          '<div class="cvl-invite-actions">' +
            '<button class="cvl-btn-ghost cvl-btn-resend">Erneut senden</button>' +
            '<button class="cvl-btn-ghost cvl-btn-revoke">Zur\u00fcckziehen</button>' +
          '</div>';

        row.querySelector('.cvl-invite-email').textContent = inv.email;
        row.querySelector('.cvl-invite-meta').textContent  = 'L\u00e4uft ab am ' + formatDate(inv.expires_at);

        var inviteId = inv.id;
        var email    = inv.email;

        row.querySelector('.cvl-btn-resend').addEventListener('click', async function () {
          var btn = this;
          btn.disabled = true; btn.textContent = '\u2026';
          try {
            await edgeFetch('/revoke-team-invite', { invite_id: inviteId, memberstack_id: currentMemberstackId });
            var res = await edgeFetch('/invite-team-member', { inviter_user_id: currentUserId, email: email });
            if (res.success) {
              showToast('Einladung erneut gesendet! \u2713', 'success');
              loadPending();
            } else {
              showToast(res.error || 'Fehler beim Senden.', 'error');
              btn.disabled = false; btn.textContent = 'Erneut senden';
            }
          } catch (e) {
            showToast('Verbindungsfehler.', 'error');
            btn.disabled = false; btn.textContent = 'Erneut senden';
          }
        });

        row.querySelector('.cvl-btn-revoke').addEventListener('click', async function () {
          var btn = this;
          btn.disabled = true; btn.textContent = '\u2026';
          try {
            var res = await edgeFetch('/revoke-team-invite', { invite_id: inviteId, memberstack_id: currentMemberstackId });
            if (res.success) {
              showToast('Einladung wurde zur\u00fcckgezogen.', 'success');
              loadPending();
            } else {
              showToast(res.error || 'Fehler beim Zur\u00fcckziehen.', 'error');
              btn.disabled = false; btn.textContent = 'Zur\u00fcckziehen';
            }
          } catch (e) {
            showToast('Verbindungsfehler.', 'error');
            btn.disabled = false; btn.textContent = 'Zur\u00fcckziehen';
          }
        });

        list.appendChild(row);
      });

    } catch (e) {
      console.error('[CVZ] loadPending error:', e);
      spinner.style.display = 'none';
      list.style.display    = 'block';
      list.innerHTML = '<div class="cvl-empty" style="color:var(--cvl-danger)">Fehler beim Laden.</div>';
    }
  }

  // ── Tabs ───────────────────────────────────────────────────────────────────

  document.querySelectorAll('.cvl-tab').forEach(function (tab) {
    tab.addEventListener('click', function () {
      document.querySelectorAll('.cvl-tab').forEach(function (t) { t.classList.remove('is-active'); });
      document.querySelectorAll('.cvl-panel').forEach(function (p) { p.classList.remove('is-active'); });
      tab.classList.add('is-active');
      var panel = qs('#cvl-panel-' + tab.getAttribute('data-tab'));
      if (panel) panel.classList.add('is-active');
      if (tab.getAttribute('data-tab') === 'pending') loadPending();
    });
  });

  // ── Invite senden ──────────────────────────────────────────────────────────

  qs('#cvl-invite-btn').addEventListener('click', async function () {
    var emailInput = qs('#cvl-invite-email');
    var email      = emailInput.value.trim();
    var btn        = qs('#cvl-invite-btn');
    if (!email)               { showToast('Bitte E-Mail eingeben.', 'error'); return; }
    if (!email.includes('@')) { showToast('Ung\u00fcltige E-Mail-Adresse.', 'error'); return; }
    btn.classList.add('is-loading');
    btn.disabled    = true;
    btn.textContent = 'Wird gesendet\u2026';
    try {
      var res = await edgeFetch('/invite-team-member', { inviter_user_id: currentUserId, email: email });
      resetInviteBtn(btn);
      if (res.success) {
        showToast('Einladung wurde gesendet! \u2713', 'success');
        emailInput.value = '';
        loadPending();
      } else {
        showToast(res.error || 'Fehler beim Senden.', 'error');
      }
    } catch (e) {
      resetInviteBtn(btn);
      showToast('Verbindungsfehler.', 'error');
    }
  });

  // ── Modal öffnen / schließen ───────────────────────────────────────────────

  async function openModal() {
    if (!window.$memberstackDom) { showToast('Nicht eingeloggt.', 'error'); return; }
    try {
      var member = await window.$memberstackDom.getCurrentMember();
      if (!member || !member.data || !member.data.id) { showToast('Nicht eingeloggt.', 'error'); return; }

      var user = await edgeFetch('/get-current-user', { memberstack_id: member.data.id });
if (user.error) { showToast('User nicht gefunden.', 'error'); return; }
      if (!user) { showToast('User nicht gefunden.', 'error'); return; }

      currentUserId        = user.owner_user_id || user.id;
      currentTeamId        = user.team_id       || null;
      currentMemberstackId = member.data.id;
      currentUserIsOwner   = !user.owner_user_id;

      var overlay = qs('#cvl-team-overlay');
      overlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';

      document.querySelectorAll('.cvl-tab').forEach(function (t) { t.classList.remove('is-active'); });
      document.querySelectorAll('.cvl-panel').forEach(function (p) { p.classList.remove('is-active'); });
      document.querySelector('[data-tab="members"]').classList.add('is-active');
      qs('#cvl-panel-members').classList.add('is-active');
      qs('#cvl-members-spinner').style.display = 'block';
      qs('#cvl-member-list').style.display     = 'none';

      loadMembers();

    } catch (e) {
      console.error('[CVZ] openModal error:', e);
      showToast('Fehler beim \u00d6ffnen. Bitte erneut versuchen.', 'error');
    }
  }

  function closeModal() {
    qs('#cvl-team-overlay').classList.remove('is-open');
    document.body.style.overflow = '';
  }

  var openBtn = document.getElementById('open-team-modal');
  if (openBtn) openBtn.addEventListener('click', openModal);
  qs('#cvl-close-btn').addEventListener('click', closeModal);
  qs('#cvl-team-overlay').addEventListener('click', function (e) { if (e.target === this) closeModal(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

  window.openTeamModal = openModal;

})();
</script>
